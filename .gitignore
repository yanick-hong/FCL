# Local data and experiment artifacts. Keep these outside version control.
data/
dataset/
outputs/
save/
weights/

# Legacy/generated runtime directories.
cache/
val/
datasets/
__pycache__/
*.py[cod]

# Local environment and notebook state.
.venv/
venv/
.env
